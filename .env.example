# ==============================================================================
# VISTERIA PEOPLE & PROCESS EXCELLENCE AI SURVEY PLATFORM
# ROOT / DOCKER DEPLOYMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server settings
NODE_ENV=production
PORT=3000
CLIENT_URL="http://localhost:3000,http://localhost:5173"

# MongoDB Replica Set connection URL
DATABASE_URL="mongodb://mongo:27017/visteria_db?replicaSet=rs0&directConnection=true"

# JWT Authentication Secrets (Generate with: openssl rand -base64 64)
JWT_SECRET="replace-with-minimum-64-char-cryptographically-secure-random-jwt-secret"
JWT_ACCESS_SECRET="replace-with-minimum-64-char-cryptographically-secure-random-access-secret"
JWT_REFRESH_SECRET="replace-with-minimum-64-char-cryptographically-secure-random-refresh-secret"

# Initial Super Administrator Setup
SUPER_ADMIN_NAME="Visteria System Administrator"
SUPER_ADMIN_EMAIL="admin@yourcompany.com"
SUPER_ADMIN_PASSWORD="replace-with-strong-super-admin-password"
ALLOW_SEED_IN_PRODUCTION=false

# Optional Integrations
ANTHROPIC_API_KEY=""
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASS=""
SMTP_FROM="Visteria AI Survey <noreply@yourcompany.com>"
SENDGRID_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
