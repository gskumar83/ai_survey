# ==============================================================================
# VISTERIA PEOPLE & PROCESS EXCELLENCE AI SURVEY PLATFORM
# BACKEND SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the server directory: cp .env.example .env
# 2. Replace all placeholder values (<...>) with production values.
# 3. Never commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER RUNTIME & NETWORKING (REQUIRED)
# ------------------------------------------------------------------------------
# The runtime environment: 'production' or 'development'
NODE_ENV=production

# The port on which the Express server listens (default: 3000)
PORT=3000

# Allowed client origins for Cross-Origin Resource Sharing (CORS).
# For multiple domains, separate with commas without spaces.
# Example: https://survey.yourcompany.com,https://admin.yourcompany.com
CLIENT_URL="http://localhost:5173,http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION - MONGODB (REQUIRED)
# ------------------------------------------------------------------------------
# Prisma on MongoDB requires a Replica Set for transactions.
#
# Production (MongoDB Atlas):
# DATABASE_URL="mongodb+srv://<db_user>:<db_password>@<cluster-url>/visteria_db?retryWrites=true&w=majority"
#
# Docker / Self-Hosted MongoDB Replica Set:
# DATABASE_URL="mongodb://<db_user>:<db_password>@mongodb:27017/visteria_db?replicaSet=rs0&authSource=admin"
#
# Local Development (mongod running with --replSet rs0):
DATABASE_URL="mongodb://127.0.0.1:27017/visteria_db?replicaSet=rs0&directConnection=true"

# Optional path to local mongod binary (only if running embedded local dev)
# MONGOD_PATH="/usr/bin/mongod"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY TOKENS (REQUIRED)
# ------------------------------------------------------------------------------
# Generate cryptographically strong random secrets for JWT signing.
# In Linux/macOS: openssl rand -base64 64
JWT_SECRET="replace-with-minimum-64-char-cryptographically-secure-random-jwt-secret"
JWT_ACCESS_SECRET="replace-with-minimum-64-char-cryptographically-secure-random-access-secret"
JWT_REFRESH_SECRET="replace-with-minimum-64-char-cryptographically-secure-random-refresh-secret"

# ------------------------------------------------------------------------------
# 4. INITIAL SUPER ADMINISTRATOR BOOTSTRAP (OPTIONAL / FIRST RUN)
# ------------------------------------------------------------------------------
# If specified, the server creates or updates the primary system administrator
# upon startup if no administrator exists.
SUPER_ADMIN_NAME="Visteria System Administrator"
SUPER_ADMIN_EMAIL="admin@yourcompany.com"
SUPER_ADMIN_PASSWORD="replace-with-strong-super-admin-password"

# Safety flag: set to 'true' only if executing manual seed script in production
ALLOW_SEED_IN_PRODUCTION=false

# ------------------------------------------------------------------------------
# 5. AI ASSISTANT & INSIGHTS ENGINE (OPTIONAL BUT RECOMMENDED)
# ------------------------------------------------------------------------------
# Anthropic Claude API key for Eagle AI chat assistant and survey theme analysis.
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & PASSWORD RESET (SMTP) (OPTIONAL)
# ------------------------------------------------------------------------------
# Configure SMTP credentials for sending survey invitations, confirmation codes,
# and administrator password reset links.
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASS=""
SMTP_FROM="Visteria AI Survey <noreply@yourcompany.com>"

# Optional direct SendGrid API Key if using SendGrid provider:
SENDGRID_API_KEY=""

# ------------------------------------------------------------------------------
# 7. CLOUD STORAGE (AWS S3 / S3-COMPATIBLE) (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional object storage configuration for exported report backups or attachments.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
