# ==============================================================================
# VISTERIA PEOPLE & PROCESS EXCELLENCE AI SURVEY PLATFORM
# FRONTEND CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the client directory: cp .env.example .env
# 2. Configure the API URL to point to your backend.
# ==============================================================================

# Backend API base URL for React client (Axios client)
# - In Split Deployment (e.g. Vercel frontend, VPS backend):
#   VITE_API_URL="https://api.yourcompany.com/api"
# - In Unified / Reverse-Proxy Deployment (Nginx proxying /api to backend):
#   VITE_API_URL="/api"
# - In Local Development:
VITE_API_URL="http://localhost:3000/api"
